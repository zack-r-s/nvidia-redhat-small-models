# The chat requests VLLM_MODEL_NAME (vLLM --served-model-name), else providers.yml's default.
# scripts/bootstrap_demo.sh --model/--served-name appends it here.
# Osprey expects a provider key even when a local vLLM server ignores auth.
VLLM_API_KEY=local-vllm
# The custom chat runs on the host; change this if vLLM runs elsewhere.
VLLM_BASE_URL=http://127.0.0.1:8000/v1
