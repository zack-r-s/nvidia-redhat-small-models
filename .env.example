# Demo model: public checkpoint, pinned to the v004 release.
VLLM_MODEL=zack-r-s/hackring-LFM2.5-230M
VLLM_REVISION=v004
VLLM_SERVED_NAME=LFM2.5-230M
VLLM_MODEL_NAME=LFM2.5-230M
VLLM_BASE_URL=http://127.0.0.1:8000/v1
# Local placeholder; no paid API key is required.
VLLM_API_KEY=local-vllm
# Matches the development demo. Adjust for your inference hardware if needed.
VLLM_SERVE_ARGS="--max-model-len 4096 --gpu-memory-utilization 0.05"
# Optional: set the path to an existing vLLM / vLLM Metal executable.
# VLLM_BIN=/absolute/path/to/vllm
