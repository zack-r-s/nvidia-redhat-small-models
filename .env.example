# Set the API name with --served-model-name LFM2.5-230M, or edit providers.yml.
# Osprey expects a provider key even when a local vLLM server ignores auth.
VLLM_API_KEY=local-vllm
# Replace this host alias if it is unreachable from the Osprey process.
VLLM_BASE_URL=http://host.docker.internal:8000/v1
